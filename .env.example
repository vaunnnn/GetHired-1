# Next.js server configuration. Copy to .env.local; never expose these as NEXT_PUBLIC_*.
# Generate API_GATEWAY_SECRET once and use the SAME value in apps/api/.env.local.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Standalone npm development only. Vercel injects API_SERVICE_URL via the binding;
# never set API_SERVICE_URL yourself (including in local env files).
API_BASE_URL=http://127.0.0.1:4000
API_GATEWAY_SECRET=REPLACE-WITH-64-RANDOM-HEX-CHARACTERS

# Production only: one IP header that the frontend ingress removes/overwrites.
# Do not configure a header until that trust boundary has been verified.
# Vercel staging: x-vercel-forwarded-for; see docs/backend-b2-staging.md.
API_INGRESS_IP_HEADER=
# Use true only for explicitly trusted private server-to-server HTTP connectivity.
API_ALLOW_PRIVATE_HTTP=false

# Supabase/auth/database settings now belong ONLY in apps/api/.env.local.
# With both API_SERVICE_URL and API_BASE_URL absent, /api returns safe 503 responses.
