            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Introduce yourself\",\n  \"type\": \"Introduction\",\n  \"hint\": \"Be specific\",\n  \"feedback\": \"Private test rubric\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected success status', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Envelope has request ID and data', () => { pm.expect(body.requestId).to.be.a('string'); pm.expect(body).to.have.property('data'); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('questionId', body.data.id);"
                ]
              }
