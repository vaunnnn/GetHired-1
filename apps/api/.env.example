# Copy to apps/api/.env.local. npm run dev:api loads this file explicitly.
PORT=4000
# Browser-facing frontend origin, not the API's Render origin.
APP_ORIGIN=http://localhost:3000
# Use the SAME generated gateway secret as the frontend .env.local.
API_GATEWAY_SECRET=REPLACE-WITH-64-RANDOM-HEX-CHARACTERS
API_MAX_BODY_BYTES=65536
API_LOG_DESTINATION=stdout
# Optional diagnostics labels; set from verified hosting/database configuration.
# API_REGION falls back to VERCEL_REGION; unknown labels remain unknown in logs.
API_REGION=
DATABASE_REGION=

# Set true after completing docs/backend-b2-staging.md; disabled auth/readiness return 503.
AUTH_ENABLED=false
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# API/cleanup worker only. Never expose this privileged key to Next.js or browsers.
SUPABASE_STORAGE_SECRET_KEY=
COMPANY_IMAGE_BUCKET=company-images
SUPABASE_JWT_ALGORITHMS=ES256
DATABASE_URL=postgresql://APP-LOGIN:PASSWORD@DATABASE-HOST:5432/postgres
# Optional local Supabase CA certificate; set an absolute path in .env.local.
# NODE_EXTRA_CA_CERTS=D:/GetHired/supabase-ca.crt
# Separate secret from API_GATEWAY_SECRET; generate once, share across API instances.
AUTH_COOKIE_SECRET=REPLACE-WITH-64-RANDOM-HEX-CHARACTERS
# Production enabled auth requires this exact authenticated gateway header.
# Leave blank in development for the existing conservative shared IP bucket.
AUTH_TRUSTED_IP_HEADER=

# B5: API and onboarding worker only. Separate from cookie/gateway secrets.
SUPABASE_AUTH_SECRET_KEY=
AUTH_SETUP_ENCRYPTION_KEY=
# Match Supabase email OTP expiry (seconds), 300-900; recommended 600.
AUTH_SETUP_TTL_SECONDS=600
